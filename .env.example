# === Required ===
# None — all default data sources are free/keyless

# === Optional (unlock additional signals) ===
# FRED_API_KEY=            # Federal Reserve macro data (free: https://fred.stlouisfed.org/docs/api/)
# FINNHUB_API_KEY=         # Company profiles, congressional trades (free tier)
# COINMETRICS_API_KEY=     # On-chain metrics (community tier is free)
# CRYPTOMPARE_API_KEY=     # Social sentiment data (free tier)

# === Training ===
# DEVICE=cuda              # cuda, cpu, or mps
# DATA_DIR=./data          # where signals.db and preprocessed tensors live
